<div class="g listing-rows" style="padding-bottom:56px"><% for (const item of items) { %><div class="row12 linked" <%= metadataAttrs(item) %>><span class="lab" style="grid-column:1 / span 3"><%- item.date %></span><span style="grid-column:4 / span 6;font-size:1.45rem;line-height:1.2"><a class="title-link" href="<%- item.path %>"><%- item.title %></a><% if (item.description) { %><span class="slug"><%- item.description %></span><% } %></span><span class="lab" style="grid-column:10 / span 3;text-align:right"><%- (item.categories || []).slice(0, 2).join(' · ') %></span></div><% } %><div class="span-all" style="border-top:1px solid var(--rule)"></div></div>
