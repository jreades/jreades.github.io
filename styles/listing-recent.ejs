<div class="g listing-recent" style="padding-bottom:88px"><div class="lab" style="grid-column:1 / span 3;grid-row:1 / span 5;padding-top:6px">Recent writing</div><% for (const item of items) { %><div class="row12 row-hang linked" <%= metadataAttrs(item) %>><span class="lab" style="grid-column:1 / span 2"><%- item.date %></span><span style="grid-column:3 / span 5;font-size:1.3rem;line-height:1.2"><a href="<%- item.path %>"><%- item.title %></a></span><span class="lab" style="grid-column:8 / span 2;text-align:right"><%- (item.categories || [])[0] || '' %></span></div><% } %><div style="grid-column:4 / span 9;border-top:1px solid var(--rule)"></div></div>
